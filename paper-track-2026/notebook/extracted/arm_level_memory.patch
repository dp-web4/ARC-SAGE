+    # -- level memory (ARC3_LEVEL_MEMORY) ---------------------------------
+    def _level_memory_reset(self) -> None:
+        self._lm_entries: dict[int, dict[str, Any]] = {}
+        # bounded tail of the CURRENT attempt on the current level
+        self._lm_level_actions: list[str] = []
+        self._lm_attempt_actions = 0
+        # a level just cleared, waiting for the model's one-line rule
+        self._lm_pending: dict[str, Any] | None = None
+        # the latest reasoning (or text) the model wrote, for the fallback
+        self._lm_last_thought = ""
+        # transcript lines, flushed by analyze() where append_transcript exists
+        self._lm_gauges: list[str] = []
+        self._lm_suspended = False
+        self._lm_ask_level: int | None = None
+
+    def _level_memory_ready(self) -> None:
+        # an agent unpickled from before this feature existed
+        if not hasattr(self, "_lm_entries"):
+            self._level_memory_reset()
+
+    def _level_memory_observe_step(self, summary: dict[str, Any]) -> None:
+        self._level_memory_ready()
+        tail_cap = _level_memory_action_tail()
+        if summary.get("game_over"):
+            # the level restarted: nothing before this is part of the attempt
+            # that will eventually clear it
+            self._lm_level_actions = []
+            self._lm_attempt_actions = 0
+        else:
+            for name in summary.get("executed_actions") or []:
+                name = str(name).strip()
+                if not name:
+                    continue
+                if name.split("(")[0].strip().upper() == "RESET":
+                    self._lm_level_actions = []
+                    self._lm_attempt_actions = 0
+                    continue
+                self._lm_level_actions.append(name)
+                self._lm_attempt_actions += 1
+            self._lm_level_actions = self._lm_level_actions[-tail_cap:]
+        if summary.get("level_transition") and not summary.get("run_complete"):
+            try:
+                new_level = int(summary.get("level") or 2)
+            except (TypeError, ValueError):
+                new_level = 2
+            if self._lm_pending is not None:
+                # a second clear before the first was answered
+                self._level_memory_finalize("", "fallback")
+            self._lm_pending = {
+                "level": max(1, new_level - 1),
+                "actions": list(self._lm_level_actions[-tail_cap:]),
+                "attempt_actions": self._lm_attempt_actions,
+                "thought": self._lm_last_thought,
+                "asked": False,
+            }
+            self._lm_level_actions = []
+            self._lm_attempt_actions = 0
+
+    def _level_memory_observe_reply(self, reasoning: str, content: str) -> None:
+        self._level_memory_ready()
+        pending = self._lm_pending
+        if pending is not None:
+            level = int(pending["level"])
+            rule = _level_memory_find_rule(content, level)
+            source = "content"
+            if not rule:
+                rule = _level_memory_find_rule(reasoning, level)
+                source = "reasoning"
+            if rule:
+                self._level_memory_finalize(rule, source)
+        for thought in (reasoning, content):
+            if thought and not _is_degenerate_text(thought):
+                self._lm_last_thought = str(thought)[-4000:]
+                break
+
+    def _level_memory_finalize(self, rule: str, source: str) -> None:
+        pending = self._lm_pending
+        if pending is None:
+            return
+        self._lm_pending = None
+        labelled = bool(rule)
+        text = (
+            rule if labelled
+            else str(pending.get("thought") or "")[-_level_memory_fallback_chars():]
+        )
+        text = text[: _level_memory_entry_chars()]
+        level = int(pending["level"])
+        actions = list(pending.get("actions") or [])
+        self._lm_entries[level] = {
+            "level": level,
+            "rule": text,
+            "labelled": labelled,
+            "source": source if labelled else "fallback",
+            "actions": actions,
+            "attempt_actions": int(pending.get("attempt_actions") or len(actions)),
+        }
+        self._lm_gauges.append(
+            f"level_memory_capture level={level} labelled={'yes' if labelled else 'no'} "
+            f"rule_chars={len(text)} actions={len(actions)} "
+            f"source={source if labelled else 'fallback'}"
+        )
+
+    def _level_memory_ask_line(self) -> str:
+        pending = getattr(self, "_lm_pending", None)
+        if pending is None:
+            return ""
+        level = pending["level"]
+        return (
+            f"You just cleared level {level}. Before continuing, state in one line "
+            f"starting with `Rule for level {level}:` what you found the "
+            "goal/mechanic to be."
+        )
+
+    def _level_memory_entries(self) -> list[dict[str, Any]]:
+        self._level_memory_ready()
+        entries = list(self._lm_entries.values())
+        pending = self._lm_pending
+        if pending is not None and int(pending["level"]) not in self._lm_entries:
+            # a drain between the clear and the answer: carry what exists now,
+            # marked as unlabelled, rather than lose the level until next drain
+            entries.append({
+                "level": int(pending["level"]),
+                "rule": str(pending.get("thought") or "")[-_level_memory_fallback_chars():],
+                "labelled": False,
+                "actions": list(pending.get("actions") or []),
+                "attempt_actions": pending.get("attempt_actions"),
+            })
+        return entries
+
+    def _level_memory_block(self) -> dict[str, Any] | None:
+        entries = self._level_memory_entries()
+        if not entries:
+            return None
+        text = _render_level_memory_block(entries)
+        levels = ",".join(str(e["level"]) for e in sorted(entries, key=lambda e: e["level"]))
+        self._lm_gauges.append(f"level_memory_reinsert levels=[{levels}] chars={len(text)}")
+        return _mark_control_message(
+            {"role": "user", "content": text}, _LEVEL_MEMORY_CONTROL_KIND
+        )
+
+    def _level_memory_reserve_tokens(self, notes: dict[str, Any] | None) -> int:
+        candidates: list[str] = []
+        if notes is not None:
+            candidates.append(str(notes.get("content") or ""))
+        entries = self._level_memory_entries()
+        if entries:
+            candidates.append(_render_level_memory_block(entries))
+        if not candidates:
+            return 0
+        longest = max(candidates, key=len)
+        return max(
+            0,
+            self._estimate_request_input_tokens([{"role": "user", "content": longest}])
+            - self._estimate_request_input_tokens([]),
+        )
+
+    @staticmethod
+    def _level_memory_split(
+        messages: list[dict[str, Any]],
+    ) -> tuple[list[dict[str, Any]], dict[str, Any] | None]:
+        notes = None
+        kept: list[dict[str, Any]] = []
+        for message in messages:
+            if _message_is_level_memory(message):
+                notes = message
+                continue
+            kept.append(message)
+        return kept, notes
+
+    def _level_memory_attach(
+        self,
+        history: list[dict[str, Any]],
+        original_head: dict[str, Any] | None,
+        previous: dict[str, Any] | None,
+    ) -> list[dict[str, Any]]:
+        """Put the notes block at the head of `history` (system excluded).
+
+        Rebuilt only when the head of history moved - a drain, a turn cap, a
+        pruned or image-stripped head - since that is exactly when the cached
+        prefix is invalid from the first history message and the block costs
+        nothing extra. Otherwise the block that was there stays, unchanged, so
+        a level cleared since the last drain does not move the prefix; it
+        joins at the next drain."""
+        if getattr(self, "_lm_suspended", False):
+            return history
+        head_moved = original_head is not None and (
+            not history
+            or not (
+                history[0] is original_head
+                or _strip_message_images(history[0]) == _strip_message_images(original_head)
+            )
+        )
+        notes = previous
+        if head_moved:
+            notes = self._level_memory_block() or previous
+        if notes is None:
+            return history
+        return [notes, *history]
