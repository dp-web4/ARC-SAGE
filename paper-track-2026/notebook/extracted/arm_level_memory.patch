+# ---------------------------------------------------------------------------
+# Level memory (ARC3_LEVEL_MEMORY, default off).
+#
+# History is kept across levels but drained from the oldest end once the
+# prompt crosses the budget, and a long game drains several times - so the
+# derivations of the levels it already cleared are the first thing it loses,
+# and the later (higher-weight) levels pay to re-derive them. This keeps, per
+# cleared level, the model's own one-line rule (asked for once in the next
+# opener) and the tail of the actions that cleared it, and re-shows them as one
+# tagged user message right after the system prompt - but ONLY when a drain has
+# already moved the head of history, i.e. when the cached prefix is invalid
+# from the first history message anyway, so the block costs no extra prefill.
+# It is never added to the system prompt, which would force a full re-prefill
+# at every level-up.
+#
+# The block informs; it never instructs. It names its origin (the model's own
+# words from earlier levels of this game) and the prior that bounds it (the
+# mechanic may have changed; one cheap probe before relying on it).
+# ---------------------------------------------------------------------------
+_LEVEL_MEMORY_CONTROL_KIND = "level_memory"
+_LEVEL_MEMORY_HEADER = (
+    "Notes from levels you already cleared in THIS game (your own words and the "
+    "actions that won; written by you, carried by the harness because older "
+    "history was trimmed — they may not apply if the mechanic changed, so "
+    "check with one cheap probe before relying on them):"
+)
+_LEVEL_MEMORY_RULE_RE = re.compile(
+    r"rule\s+for\s+level\s*(\d+)?\s*[:\-–—]\s*(.*)", re.IGNORECASE
+)
+# an echo of the ask itself ("state in one line starting with `Rule for level
+# 1:` what you found ...") is not a rule
+_LEVEL_MEMORY_ECHO_RE = re.compile(
+    r"^\W*(what\s+(you|i)\s+found|before\s+continuing)", re.IGNORECASE
+)
+
+
+def _level_memory_enabled() -> bool:
+    """Read at call time; off unless ARC3_LEVEL_MEMORY is truthy."""
+    return _get_env_bool("ARC3_LEVEL_MEMORY", False)
+
+
+def _level_memory_action_tail() -> int:
+    return max(1, _get_env_int("ARC3_LEVEL_MEMORY_ACTIONS", 30))
+
+
+def _level_memory_fallback_chars() -> int:
+    return max(50, _get_env_int("ARC3_LEVEL_MEMORY_FALLBACK_CHARS", 400))
+
+
+def _level_memory_entry_chars() -> int:
+    return max(200, _get_env_int("ARC3_LEVEL_MEMORY_ENTRY_CHARS", 1500))
+
+
+def _level_memory_total_chars() -> int:
+    return max(500, _get_env_int("ARC3_LEVEL_MEMORY_TOTAL_CHARS", 6000))
+
+
+def _message_is_level_memory(message: dict[str, Any]) -> bool:
+    return message.get(_CONTROL_MESSAGE_KEY) == _LEVEL_MEMORY_CONTROL_KIND
+
+
+def _level_memory_find_rule(text: str, level: int) -> str:
+    """The text after the last `Rule for level N:` label in `text`.
+
+    The last match, not the first: reasoning often restates the ask before
+    answering it. A label carrying another level number is taken only when no
+    label for `level` exists (models miscount 0- vs 1-based levels)."""
+    if not text:
+        return ""
+    exact: list[str] = []
+    other: list[str] = []
+    for line in str(text).splitlines():
+        match = _LEVEL_MEMORY_RULE_RE.search(line)
+        if not match:
+            continue
+        body = match.group(2).strip().strip("`*\"' ").strip()
+        if len(body) < 8 or _LEVEL_MEMORY_ECHO_RE.match(body):
+            continue
+        number = match.group(1)
+        if number is None or number == str(level):
+            exact.append(body)
+        else:
+            other.append(body)
+    if exact:
+        return exact[-1]
+    return other[-1] if other else ""
+
+
+def _level_memory_clip(text: str, limit: int, *, keep_end: bool = False) -> str:
+    text = " ".join(str(text or "").split())
+    if len(text) <= limit:
+        return text
+    if limit <= 3:
+        return text[:limit]
+    return ("..." + text[-(limit - 3):]) if keep_end else (text[: limit - 3] + "...")
+
+
+def _render_level_memory_entry(entry: dict[str, Any], squeeze: int = 0) -> str:
+    """One cleared level. `squeeze` 0..3: 0 full, 1 and 2 progressively shorter,
+    3 a one-line stub (used for the oldest levels when the block is over cap)."""
+    level = entry.get("level")
+    if squeeze >= 3:
+        return f"Level {level}: (notes omitted for space)"
+    entry_cap = _level_memory_entry_chars()
+    rule_cap = {0: entry_cap - 300, 1: 600, 2: 250}[squeeze]
+    action_cap = {0: _level_memory_action_tail(), 1: 15, 2: 5}[squeeze]
+    actions = list(entry.get("actions") or [])
+    total_actions = int(entry.get("attempt_actions") or len(actions))
+    shown = actions[-action_cap:] if action_cap else []
+    if entry.get("labelled"):
+        head = (
+            f"Level {level} — the rule you wrote after clearing it: "
+            f"\"{_level_memory_clip(entry.get('rule', ''), max(40, rule_cap))}\""
+        )
+    else:
+        tail = _level_memory_clip(
+            entry.get("rule", ""), max(40, rule_cap), keep_end=True
+        )
+        head = (
+            f"Level {level} — you wrote no \"Rule for level {level}:\" line; "
+            "this is the end of your reasoning just before the clear, unedited "
+            f"(unlabelled): \"{tail or '(no reasoning was captured)'}\""
+        )
+    if shown:
+        action_line = (
+            f"  Actions that cleared it (last {len(shown)} of {total_actions} in the "
+            f"attempt that cleared it): {', '.join(shown)}"
+        )
+    else:
+        action_line = "  Actions that cleared it: (none recorded)"
+    text = f"{head}\n{action_line}"
+    if len(text) > entry_cap:
+        # the actions are the cheaper half to lose: keep the head whole and
+        # shorten the action line from its front (the winning end stays)
+        room = max(0, entry_cap - len(head) - 1)
+        text = f"{head}\n{_level_memory_clip(action_line, room, keep_end=True)}" if room else head[:entry_cap]
+    return text
+
+
+def _render_level_memory_block(entries: list[dict[str, Any]]) -> str:
+    """Header plus one paragraph per cleared level, oldest first, within the
+    total cap. Over the cap, the OLDEST level is squeezed first, one step at a
+    time, then the next oldest."""
+    ordered = sorted(entries, key=lambda e: int(e.get("level") or 0))
+    squeeze = [0] * len(ordered)
+    cap = _level_memory_total_chars()
+
+    def render() -> str:
+        parts = [
+            _render_level_memory_entry(entry, squeeze[i])
+            for i, entry in enumerate(ordered)
+        ]
+        return "\n\n".join([_LEVEL_MEMORY_HEADER, *parts])
+
+    text = render()
+    while len(text) > cap:
+        index = next((i for i, s in enumerate(squeeze) if s < 3), None)
+        if index is None:
+            # every level is a stub and it still does not fit: keep the newest
+            while len(ordered) > 1 and len(text) > cap:
+                ordered.pop(0)
+                squeeze.pop(0)
+                text = render()
+            return text[:cap]
+        squeeze[index] += 1
+        text = render()
+    return text
+
