+# ARC3_CAP_NUDGE (default off; thor-claude 10-10, from the 194th read of 140
+# pilot game-runs): a reply that hits max_output_tokens comes back
+# finish_reason=length with no tool call. The harness yields the turn and the
+# resumed turn re-sends the same opener, so the model is never told that its
+# last reply was cut, and ~167 s of clock went to silence (4.4% of the pilot
+# clock; ka59 13.6%, bp35 10.1%). In the cd82 read the cut text was an in-head
+# derivation that a 2-action probe then answered. With the flag on, the next
+# message after a capped reply (the resumption opener, or the in-turn follow-up
+# when no yield fires) carries one extra line: the reply was cut, nothing ran,
+# name the hypotheses and run the cheapest discriminating action. The scaffold
+# supplies the cheap test; which action, and whether to take it, stays with
+# the model. Beside it, independent: ARC3_REASONING_EFFORT_LADDER.
+_CAP_NUDGE_MARK = "[harness] Your previous reply was cut off at the output limit"
+
+
+def _cap_nudge_enabled() -> bool:
+    return _get_env_bool("ARC3_CAP_NUDGE", False)
+
+
+def _cap_nudge_text(tokens: int) -> str:
+    spent = f" ({int(tokens)} tokens of reasoning)" if tokens and tokens > 0 else ""
+    return (
+        f"{_CAP_NUDGE_MARK}{spent} before any tool call, so nothing was "
+        "executed and the board is unchanged. Do not finish that derivation in "
+        "your head. State your leading hypotheses in one line each, then run the "
+        "cheapest action that tells them apart with `action(...)` and read the "
+        "diff; a 1-2 action probe answers faster than a proof. Keep the reasoning "
+        "short enough to finish within the output limit."
+    )
+
+
+def _cap_nudge_append(message: dict[str, Any], text: str) -> None:
+    """The nudge as the opener's own last line; an opener with images gets it
+    as a final text part so the board image keeps its place in the prefix."""
+    content = message.get("content")
+    if isinstance(content, list):
+        message["content"] = [*content, {"type": "text", "text": text}]
+    else:
+        message["content"] = f"{content or ''}\n{text}"
+
+
+def _usage_completion_tokens(usage: Any) -> int:
+    if not isinstance(usage, dict):
+        return 0
+    for key in ("completion_tokens", "output_tokens", "generated_tokens"):
+        try:
+            return max(0, int(usage.get(key)))
+        except (TypeError, ValueError):
+            continue
+    return 0
+
