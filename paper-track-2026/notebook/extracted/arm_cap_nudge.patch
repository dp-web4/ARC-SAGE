+    def _cap_nudge_take(self, current_frame: Frame | None, where: str) -> str | None:
+        """ARC3_CAP_NUDGE: the nudge line for the next message after a capped
+        reply, once; writes `cap_nudge fired level=<n> where=<resume|followup>
+        tokens=<k>` to the gauge channel. None when nothing is pending."""
+        if not _cap_nudge_enabled() or self._cap_nudge_pending is None:
+            return None
+        tokens = int(self._cap_nudge_pending)
+        self._cap_nudge_pending = None
