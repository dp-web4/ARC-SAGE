+def _verify_code_key(code):
+    """A canonical, address-free text for a code object (nested ones recursed).
+
+    repr() of a nested code object carries its memory address, so constants
+    that are code objects are replaced by their own canonical text.
+    """
+    consts = []
+    for const in code.co_consts:
+        if hasattr(const, "co_code"):
+            consts.append("<code " + _verify_code_key(const) + ">")
+        else:
+            consts.append(repr(const))
+    return "code:" + code.co_code.hex() + "|consts:[" + ",".join(consts) + "]|names:" \
+        + repr(tuple(code.co_names))
+
+
+def _verify_predicate_key(fn):
+    """Source text of a predicate goal when inspect can find it, else its code.
+
+    A lambda's getsource is the whole LINE it sits on (the plan and the
+    plan_check call included), so a lambda is keyed by its code. Code passed
+    to the sandbox is compiled as '<python_tool>', where getsource finds no
+    file, so in the harness the code key is the one used.
+    """
+    if getattr(fn, "__name__", None) != "<lambda>":
+        try:
+            import inspect
+            return "source:" + inspect.getsource(fn)
+        except (OSError, TypeError):
+            pass
+    code = getattr(fn, "__code__", None)
+    if code is None:
+        code = getattr(getattr(fn, "__call__", None), "__code__", None)
+    if code is None:
+        # no source, no code (a builtin or C callable): its qualified name
+        return "callable:" + type(fn).__module__ + "." + type(fn).__qualname__ + ":" \
+            + str(getattr(fn, "__qualname__", ""))
+    return _verify_code_key(code)
+
