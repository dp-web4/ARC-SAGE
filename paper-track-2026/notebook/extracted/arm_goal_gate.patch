+def verify_goal_fingerprint(goal, border=0):
+    """12 hex chars naming a NORMALIZED goal (verify_normalize_goal) and its border.
+
+    board: its row strings; sparse: its cells sorted by (row, col) - key order,
+    numpy keys and color indices are gone after normalization; predicate: its
+    source or code (_verify_predicate_key). This identifies representations,
+    NOT semantic goals. Predicate closure/default/global bindings and callable
+    instance state are not included: opposite targets can have the same fp.
+    Conversely, equivalent goals expressed differently can have different fps.
+    Distinct counts are neither an upper nor lower bound on semantic revisions;
+    predicate call sites/bindings need review even when the fp is unchanged.
+    The gauge counts distinct representations per armed level, nothing stronger.
+    """
+    kind, value = goal
+    if kind == "board":
+        text = "board|border=%d|" % int(border or 0) + "\n".join(value)
+    elif kind == "sparse":
+        text = "sparse|border=%d|" % int(border or 0) + ";".join(
+            "%d,%d=%s" % (r, c, letter) for (r, c), letter in sorted(value.items())
+        )
+    else:
+        text = "predicate|" + _verify_predicate_key(value)
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:12]
