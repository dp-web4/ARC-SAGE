diff --git a/ARC3-Inference/inference/utils/verify_tools.py b/ARC3-Inference/inference/utils/verify_tools.py
new file mode 100644
index 0000000..d9339bd
--- /dev/null
+++ b/ARC3-Inference/inference/utils/verify_tools.py
@@ -0,0 +1,377 @@
+"""ARC3_VERIFY: cheap hypothesis tests the model can call on its own beliefs.
+
+Two tests, both offered only after the level has stalled (the gate lives in
+tool_agent.py), both optional, neither choosing an action:
+
+- replay_check(sim_fn): the model's own simulator, replayed against the
+  RECORDED transitions of the current level (the `history` the sandbox already
+  exposes). Read-only; no game action. The report sets the simulator beside the
+  trivial "nothing changes" predictor on the same transitions, because a
+  simulator that does not beat that baseline has learned nothing yet.
+- action(actions, expect=[...]): per-step expectations the model states for a
+  batch. The harness checks each executed step's observation against its
+  expectation and halts the REST of the batch at the first contradiction - the
+  one veto, and only of steps the model itself made conditional by stating
+  what it expected. Steps without an expectation run exactly as before.
+
+Everything is in the letter-coded board space the model already sees
+(`frame.ascii`), never raw numeric color IDs.
+
+This module must stay dependency-free (stdlib only, no ``from __future__``
+import): its source is spliced verbatim into the sandbox bootstrap
+(python_tool_sandbox.py), which runs under ``python -I -S``. The host imports
+it normally for the per-step expectation check in the solver, and tests.
+"""
+import time
+
+
+VERIFY_EXPECT_KEYS = ("cells", "level_up", "no_change")
+
+VERIFY_DOCS = (
+    "Verification tools (harness tools; they do not change the game).\n"
+    "\n"
+    "replay_check(sim_fn, border=0, last=None)\n"
+    "  sim_fn(state, action) -> predicted next state. `state` is a frame like\n"
+    "  history[i].frame (.ascii, .segmentation, .shape, .level, .step); `action` is the\n"
+    "  action string as recorded in history (e.g. 'UP', 'MOUSE(row=3, col=7)').\n"
+    "  Return the predicted board as an ascii string or a list of row strings (same\n"
+    "  letters as .ascii), OR a dict {(row, col): letter} to predict only those cells,\n"
+    "  OR None to abstain on that transition.\n"
+    "  The harness replays every recorded transition of THIS level (RESETs and the\n"
+    "  action that ended an attempt are skipped) and returns: transitions, checked,\n"
+    "  exact (sim fully right), baseline (a 'nothing changes' predictor fully right\n"
+    "  on the same transitions), changed / exact_on_changed (transitions where the\n"
+    "  board really moved), and the first mismatches with cell diffs\n"
+    "  [row, col, predicted, observed, before]. border=N ignores N cells at each\n"
+    "  edge (HUD bars); last=N replays only the most recent N transitions.\n"
+    "  replay_check() with no argument returns this text.\n"
+    "\n"
+    "action(actions, expect=[...])\n"
+    "  One entry per action (None = no expectation for that step), each a dict with\n"
+    "  any of: 'cells': {(row, col): letter} the board must show after that step;\n"
+    "  'level_up': True/False; 'no_change': True/False (no change inside the board\n"
+    "  area). The batch runs step by step and HALTS at the first step whose\n"
+    "  observation contradicts its expectation; the remaining actions are not\n"
+    "  executed. The result carries `expect_failure` (step, expected, observed).\n"
+    "  A single action may take a single dict."
+)
+
+
+def verify_color_letter(value, color_chars):
+    """A board letter from a letter or a 0-15 color index; ValueError otherwise."""
+    if isinstance(value, bool):
+        raise ValueError(f"color {value!r} is not a board letter")
+    if isinstance(value, int):
+        if 0 <= value < len(color_chars):
+            return color_chars[value]
+        raise ValueError(f"color index {value} is out of range 0-{len(color_chars) - 1}")
+    if isinstance(value, str) and len(value) == 1 and value in color_chars:
+        return value
+    raise ValueError(
+        f"color {value!r} is not a board letter (one of {color_chars!r})"
+    )
+
+
+def _verify_cell_key(key):
+    if isinstance(key, str):
+        parts = [p for p in key.replace("(", " ").replace(")", " ").replace(",", " ").split() if p]
+        key = tuple(parts)
+    if not isinstance(key, (tuple, list)) or len(key) != 2:
+        raise ValueError(f"cell key {key!r} must be (row, col)")
+    try:
+        return int(key[0]), int(key[1])
+    except (TypeError, ValueError):
+        raise ValueError(f"cell key {key!r} must be two integers (row, col)")
+
+
+def verify_normalize_cells(cells, color_chars):
+    """{(r, c): letter} or [(r, c, letter), ...] -> [[r, c, letter], ...]."""
+    out = []
+    if isinstance(cells, dict):
+        items = list(cells.items())
+    elif isinstance(cells, (list, tuple)):
+        items = []
+        for item in cells:
+            if not isinstance(item, (list, tuple)) or len(item) != 3:
+                raise ValueError(f"cell entry {item!r} must be (row, col, letter)")
+            items.append(((item[0], item[1]), item[2]))
+    else:
+        raise ValueError("'cells' must be a dict {(row, col): letter}")
+    for key, value in items:
+        r, c = _verify_cell_key(key)
+        out.append([r, c, verify_color_letter(value, color_chars)])
+    return out
+
+
+def verify_normalize_expect(expect, n_actions, color_chars):
+    """The model's expect argument -> a JSON-safe list, one entry per action.
+
+    Raises ValueError/TypeError BEFORE anything runs, so a malformed
+    expectation costs no action.
+    """
+    if expect is None:
+        return None
+    if isinstance(expect, dict):
+        if n_actions != 1:
+            raise ValueError(
+                "expect must be a list with one entry per action (None for steps "
+                "without an expectation) when more than one action is submitted"
+            )
+        expect = [expect]
+    if not isinstance(expect, (list, tuple)):
+        raise TypeError("expect must be a list of dicts/None, one per action")
+    if len(expect) > n_actions:
+        raise ValueError(
+            f"expect has {len(expect)} entries but only {n_actions} action(s) were submitted"
+        )
+    steps = []
+    for index, spec in enumerate(expect, start=1):
+        if spec is None:
+            steps.append(None)
+            continue
+        if not isinstance(spec, dict):
+            raise TypeError(f"expect entry {index} must be a dict or None")
+        unknown = [k for k in spec if k not in VERIFY_EXPECT_KEYS]
+        if unknown:
+            raise ValueError(
+                f"expect entry {index} has unknown key(s) {unknown!r}; "
+                f"use {list(VERIFY_EXPECT_KEYS)!r}"
+            )
+        entry = {}
+        if "cells" in spec and spec["cells"] is not None:
+            entry["cells"] = verify_normalize_cells(spec["cells"], color_chars)
+        for flag in ("level_up", "no_change"):
+            if flag in spec and spec[flag] is not None:
+                if not isinstance(spec[flag], bool):
+                    raise ValueError(f"expect entry {index}: {flag!r} must be True or False")
+                entry[flag] = spec[flag]
+        steps.append(entry or None)
+    steps.extend([None] * (n_actions - len(steps)))
+    return steps
+
+
+def verify_check_expectation(spec, rows, *, level_up, no_change, max_cells=8):
+    """Contradictions between one step's stated expectation and its observation.
+
+    rows: the board after the step as letter rows. level_up / no_change: the
+    harness's own measurements for that step (None = not measured, which is
+    reported as such and never counted as a contradiction).
+    Returns (failures, checked) where failures is a list of dicts.
+    """
+    failures = []
+    checked = 0
+    if not spec:
+        return failures, checked
+    cell_failures = []
+    for r, c, want in spec.get("cells") or []:
+        checked += 1
+        observed = None
+        if 0 <= r < len(rows) and 0 <= c < len(rows[r]):
+            observed = rows[r][c]
+        if observed != want:
+            cell_failures.append({"cell": [r, c], "expected": want, "observed": observed})
+    if cell_failures:
+        failures.append({
+            "kind": "cells",
+            "wrong": len(cell_failures),
+            "of": len(spec.get("cells") or []),
+            "diffs": cell_failures[:max(1, int(max_cells))],
+        })
+    for flag, observed in (("level_up", level_up), ("no_change", no_change)):
+        if flag not in spec:
+            continue
+        checked += 1
+        if observed is None:
+            continue
+        if bool(observed) != bool(spec[flag]):
+            failures.append({"kind": flag, "expected": bool(spec[flag]), "observed": bool(observed)})
+    return failures, checked
+
+
+def verify_describe_failure(failure):
+    """One compact clause per failed expectation, for stop_detail and stdout."""
+    parts = []
+    for item in failure.get("failed") or []:
+        if item.get("kind") == "cells":
+            diffs = ", ".join(
+                f"({d['cell'][0]},{d['cell'][1]}) expected {d['expected']!r} observed {d['observed']!r}"
+                for d in item.get("diffs") or []
+            )
+            more = item["wrong"] - len(item.get("diffs") or [])
+            parts.append(
+                f"{item['wrong']} of {item['of']} expected cell(s) wrong: {diffs}"
+                + (f" (+{more} more)" if more > 0 else "")
+            )
+        else:
+            parts.append(
+                f"{item['kind']} expected {item['expected']} observed {item['observed']}"
+            )
+    return "; ".join(parts)
+
+
+def verify_rows_of(value):
+    """A predicted full board as a list of row strings, or None if not one."""
+    if isinstance(value, str):
+        return value.split("\n")
+    if isinstance(value, (list, tuple)) and value:
+        if all(isinstance(row, str) for row in value):
+            return list(value)
+    return None
+
+
+def verify_prediction(pred, color_chars):
+    """sim_fn's return -> ('none', None) | ('full', rows) | ('sparse', {(r, c): letter}).
+
+    Raises ValueError for a value of no recognised shape.
+    """
+    if pred is None:
+        return "none", None
+    if isinstance(pred, dict):
+        sparse = {}
+        for key, value in pred.items():
+            sparse[_verify_cell_key(key)] = verify_color_letter(value, color_chars)
+        return "sparse", sparse
+    ascii_text = getattr(pred, "ascii", None)
+    if isinstance(ascii_text, str):
+        return "full", ascii_text.split("\n")
+    rows = verify_rows_of(pred)
+    if rows is not None:
+        return "full", rows
+    if isinstance(pred, (list, tuple)) and pred and all(isinstance(r, (list, tuple)) for r in pred):
+        return "full", [
+            "".join(verify_color_letter(v, color_chars) for v in row) for row in pred
+        ]
+    raise ValueError(
+        f"sim_fn returned {type(pred).__name__}; expected an ascii string, a list of "
+        "row strings, a dict {(row, col): letter}, or None"
+    )
+
+
+def verify_replay(
+    transitions,
+    sim_fn,
+    *,
+    color_chars,
+    border=0,
+    max_mismatches=3,
+    max_cells=8,
+    seconds=10.0,
+):
+    """Replay recorded transitions through sim_fn; compare with what happened.
+
+    transitions: list of dicts {index, step, action, before (letter rows),
+    after (letter rows), state (a fresh frame object for sim_fn)}. The caller
+    builds `state` per transition so sim_fn can never mutate the record.
+    """
+    border = max(0, int(border or 0))
+    started = time.monotonic()
+    report = {
+        "transitions": len(transitions),
+        "checked": 0,
+        "abstained": 0,
+        "errors": 0,
+        "exact": 0,
+        "baseline": 0,
+        "changed": 0,
+        "exact_on_changed": 0,
+        "mismatches": 0,
+        "border": border,
+        "timed_out": False,
+        "first_error": None,
+        "first_mismatches": [],
+    }
+
+    def in_region(r, c, n_rows, n_cols):
+        return border <= r < n_rows - border and border <= c < n_cols - border
+
+    for item in transitions:
+        if seconds is not None and time.monotonic() - started > float(seconds):
+            report["timed_out"] = True
+            break
+        before = item["before"]
+        after = item["after"]
+        try:
+            pred = sim_fn(item["state"], item["action"])
+            kind, value = verify_prediction(pred, color_chars)
+        except Exception as exc:  # the model's code; report, never raise
+            report["errors"] += 1
+            if report["first_error"] is None:
+                report["first_error"] = (
+                    f"{type(exc).__name__}: {exc} (transition {item['index']}, "
+                    f"action {item['action']!r})"
+                )
+            continue
+        if kind == "none":
+            report["abstained"] += 1
+            continue
+        report["checked"] += 1
+        n_rows = len(after)
+        n_cols = max((len(r) for r in after), default=0)
+        wrong = []
+        baseline_ok = True
+        moved = False
+        shape_note = None
+        if kind == "full":
+            if len(value) != n_rows or any(len(value[r]) != len(after[r]) for r in range(min(len(value), n_rows))):
+                shape_note = (
+                    f"predicted shape {len(value)}x{max((len(r) for r in value), default=0)} "
+                    f"!= observed {n_rows}x{n_cols}"
+                )
+            for r in range(n_rows):
+                for c in range(len(after[r])):
+                    if not in_region(r, c, n_rows, n_cols):
+                        continue
+                    obs = after[r][c]
+                    prev = before[r][c] if r < len(before) and c < len(before[r]) else None
+                    if prev != obs:
+                        moved = True
+                        baseline_ok = False
+                    guess = value[r][c] if r < len(value) and c < len(value[r]) else None
+                    if guess != obs:
+                        wrong.append([r, c, guess, obs, prev])
+        else:
+            for (r, c), guess in sorted(value.items()):
+                obs = after[r][c] if 0 <= r < n_rows and 0 <= c < len(after[r]) else None
+                prev = before[r][c] if 0 <= r < len(before) and 0 <= c < len(before[r]) else None
+                if prev != obs:
+                    moved = True
+                    baseline_ok = False
+                if guess != obs:
+                    wrong.append([r, c, guess, obs, prev])
+        exact = not wrong and shape_note is None
+        if exact:
+            report["exact"] += 1
+        if baseline_ok:
+            report["baseline"] += 1
+        if moved:
+            report["changed"] += 1
+            if exact:
+                report["exact_on_changed"] += 1
+        if not exact:
+            report["mismatches"] += 1
+            if len(report["first_mismatches"]) < max(0, int(max_mismatches)):
+                entry = {
+                    "index": item["index"],
+                    "step": item["step"],
+                    "action": item["action"],
+                    "prediction": kind,
+                    "wrong_cells": len(wrong),
+                    "cells": wrong[:max(1, int(max_cells))],
+                }
+                if shape_note:
+                    entry["shape"] = shape_note
+                report["first_mismatches"].append(entry)
+    report["seconds"] = round(time.monotonic() - started, 3)
+    if report["checked"]:
+        report["verdict"] = (
+            f"sim exact on {report['exact']}/{report['checked']} checked transitions "
+            f"({report['exact_on_changed']}/{report['changed']} of those where the board "
+            f"changed); the nothing-changes baseline is exact on {report['baseline']}/"
+            f"{report['checked']}"
+            + (" - the sim does NOT beat it" if report["exact"] <= report["baseline"] else "")
+        )
+    else:
