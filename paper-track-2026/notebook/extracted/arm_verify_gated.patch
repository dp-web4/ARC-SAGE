+    def _verify_state(self) -> dict[str, Any]:
+        state = getattr(self, "_verify", None)
+        if state is None:
+            state = {"armed_level": None, "arm_action": 0, "opener_pending": False, "status": []}
+            self._verify = state
+        return state
+
+    def _verify_armed(self) -> bool:
+        state = getattr(self, "_verify", None)
+        return bool(_verify_enabled() and state and state["armed_level"] is not None)
+
+    def _verify_gate(self, current_frame: Frame | None, action_num: int) -> None:
+        """Arm the tools for this level once it has stalled. Turn start only."""
+        if not _verify_enabled() or current_frame is None:
+            return
+        state = self._verify_state()
+        level = int(current_frame.level)
+        if state["armed_level"] == level:
+            return
+        if state["armed_level"] is not None:
+            # the level moved without a step summary saying so; close it out
+            self._verify_disarm(action_num, cleared=level > state["armed_level"])
+        config = _verify_config()
+        if level < config["from_level"]:
+            return
+        tokens = max(
+            0, self._session_generated_tokens - getattr(self, "_tokens_at_level_start", 0)
+        )
+        actions = max(0, int(action_num) - getattr(self, "_actions_at_level_start", 0))
+        gate = config["gate"]
+        trigger = None
+        if gate == "always":
+            trigger = "always"
+        elif gate in ("stall", "tokens", "actions"):
+            if gate != "actions" and config["tokens"] > 0 and tokens >= config["tokens"]:
+                trigger = "tokens"
+            elif gate != "tokens" and config["actions"] > 0 and actions >= config["actions"]:
+                trigger = "actions"
+        if trigger is None:
+            return
+        state.update(armed_level=level, arm_action=int(action_num), opener_pending=True)
+        state["status"].append(
+            f"verify_armed level={level} tokens={tokens} actions={actions} trigger={trigger}"
+        )
