+# ARC3_PRIOR_CARD_TRIGGER (default unset = "verify": the card rides the verify
+# opener as above). "stall" gives the card its OWN gate, independent of
+# ARC3_VERIFY (the LEAN stack runs it with the verify tools off): at a turn's
+# start, once a level has taken ARC3_PRIOR_CARD_ACTIONS (default 50) actions
+# without clearing - counted exactly as the verify gate counts them, from the
+# level-start action count the agent keeps for every run - that turn's opener
+# carries the card as its own line, once per level, and
+# `prior_card fired level=<n> trigger=stall` is written. Under "stall" the
+# verify opener no longer carries the card, so it never fires twice. Any other
+# value is the default. Off (ARC3_PRIOR_CARD unset/0) nothing here runs.
+def _prior_card_stall_trigger() -> bool:
+    return (
+        _prior_card_enabled()
+        and os.environ.get("ARC3_PRIOR_CARD_TRIGGER", "").strip().lower() == "stall"
+    )
+
+
+def _prior_card_actions() -> int:
+    return _get_env_int("ARC3_PRIOR_CARD_ACTIONS", 50)
+
