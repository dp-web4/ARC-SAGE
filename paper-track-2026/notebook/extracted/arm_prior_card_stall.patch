+    def _prior_card_gate(self, current_frame: Frame | None, action_num: int) -> None:
+        """ARC3_PRIOR_CARD_TRIGGER=stall: queue the card once per level, at the
+        first turn start with >= ARC3_PRIOR_CARD_ACTIONS actions on the level.
+        The action count is the verify gate's (same level-start counter)."""
+        if current_frame is None:
+            return
+        state = self._verify_state()
+        fired = state.setdefault("prior_card_levels", set())
+        level = int(current_frame.level)
+        if level in fired:
+            return
+        threshold = _prior_card_actions()
+        actions = max(0, int(action_num) - getattr(self, "_actions_at_level_start", 0))
+        if threshold <= 0 or actions < threshold:
+            return
+        fired.add(level)
+        state["prior_card_pending"] = level
+
+    def _prior_card_opener(self, user_prompt: str) -> str:
+        """The card as its own line on the first opener after its stall gate."""
+        state = getattr(self, "_verify", None)
+        if not _prior_card_stall_trigger() or not state or state.get("prior_card_pending") is None:
+            return user_prompt
+        level = state.pop("prior_card_pending")
+        state["status"].append(f"prior_card fired level={level} trigger=stall")
+        return user_prompt + "\n" + _prior_card_text()
+
