+                "refused_by": None,
+                "refusal_detail": None,
+                "action_num": payload.get("action_num"),
+                "level_after": payload.get("level"),
+                "board_changed": _bool_or_none(payload.get("board_changed")),
+                "gameplay_changed": _bool_or_none(payload.get("gameplay_changed")),
+                "no_op": _bool_or_none(payload.get("no_op")),
+                "verdict": _action_verdict(payload),
+                "level_completed": _bool_or_none(payload.get("level_completed")),
+                "game_over": _bool_or_none(payload.get("game_over")),
+                "run_complete": _bool_or_none(payload.get("run_complete")),
+                "state": payload.get("state"),
+                "score": payload.get("score"),
+                "reward": payload.get("reward"),
+                "automatic": bool(payload.get("automatic")),
+                "run_elapsed_seconds": payload.get("run_elapsed_seconds"),
+            }
+        )
+        return record
