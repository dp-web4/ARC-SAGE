+# ARC3_ACTION_LOG: one JSON line per action attempt, written to
+# <job_dir>/<game>_p<pass>_actions.jsonl beside the request log, for offline
+# analysis only. Nothing it writes reaches the model: the records are built
+# from the payload _execute_action already returns (copied, never mutated) and
+# go to a file no prompt reads. Read when the game's session is built, so a
+# test or notebook can set it per run. Off by default; off, no code path below
+# runs and every artifact is what it was without it.
+#
+# Not in benchmark.json: taaf's GameRun.to_json_dict() lists its fields
+# explicitly, so an extra attribute on the run would be dropped on save, and
+# extending it means changing taaf (a separate repository, also staged
+# separately on Kaggle).
+def _action_log_enabled() -> bool:
+    return os.environ.get("ARC3_ACTION_LOG", "0").strip().lower() in (
+        "1", "true", "yes", "on"
+    )
+
+
+def _bool_or_none(value: Any) -> bool | None:
+    """A measured verdict, or None. Never coerces an absent reading to False."""
+    return value if isinstance(value, bool) else None
+
