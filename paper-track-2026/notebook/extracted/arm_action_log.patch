+    def _start_action_log(self) -> None:
+        try:
+            self.action_log_path.parent.mkdir(parents=True, exist_ok=True)
+            self.action_log_path.write_text("", encoding="utf-8")
+        except Exception as exc:  # logging must never change play
+            log.warning("action log: cannot create %s: %s", self.action_log_path, exc)
+
+    def _append_action_log(self, record: dict[str, Any]) -> None:
+        try:
+            with self.action_log_path.open("a", encoding="utf-8") as handle:
+                handle.write(json.dumps(record, sort_keys=True, default=str) + "\n")
+        except Exception as exc:  # logging must never change play
+            log.warning("action log: cannot append to %s: %s", self.action_log_path, exc)
+
+    def _action_log_record(
+        self,
+        *,
+        action: arcengine.ActionInput,
+        payload: dict[str, Any] | None,
+        level_before: int | None,
+        batch_index: int,
+        batch_size: int,
+        generated_tokens: int | None,
+        refusal: tuple[str | None, str | None] | None = None,
+    ) -> dict[str, Any]:
+        """One action attempt, from values the harness already computed.
+
+        Executed: every outcome is the payload's own field (_execute_action's
+        grid comparison, interior verdict and engine state), copied as is;
+        a field the payload does not carry as a bool is null, not False.
+        Refused (a guard or the staleness check stopped it before the engine
+        saw it): executed is False and every outcome is null.
+        """
+        run = self.game.game_run
+        analyzer = self.analyzer
+        session_tokens = getattr(analyzer, "_session_generated_tokens", None)
+        level_start_tokens = getattr(analyzer, "_tokens_at_level_start", None)
+        try:
+            tokens_on_level = (
+                int(session_tokens) - int(level_start_tokens)
+                if session_tokens is not None and level_start_tokens is not None
+                else None
+            )
+        except (TypeError, ValueError):
+            tokens_on_level = None
+        engine_name = action.id.name
+        data = dict(action.data or {})
+        click = None
+        if action.id == arcengine.GameAction.ACTION6:
+            model_data = _model_mouse_action_data(data)
+            click = {
+                "row": model_data["row"],
+                "col": model_data["col"],
+                "x": data.get("x"),
+                "y": data.get("y"),
+            }
+        self._action_log_seq += 1
+        now = time.time()
+        record: dict[str, Any] = {
+            "game_id": run.game_id if run is not None else str(self.game_index),
+            "pass": self.pass_index,
+            "seq": self._action_log_seq,
+            "analysis_step": self.analysis_step,
+            "batch_id": self._action_log_batch_id,
+            "batch_index": batch_index,
+            "batch_size": batch_size,
+            "level": level_before,
+            "action": engine_name,
+            "model_action": to_model_action(engine_name),
+            "action_display": _format_action_display(engine_name, data),
+            "click": click,
+            "wall_time": now,
+            "wall_time_iso": datetime.fromtimestamp(now).astimezone().isoformat(),
+            "session_generated_tokens": session_tokens,
+            "tokens_at_level_start": level_start_tokens,
+            "tokens_on_level": tokens_on_level,
+            "game_generated_tokens": (
+                _analyzer_reported_tokens(analyzer) - self.game_token_baseline
+            ),
+            "generated_tokens_charged": generated_tokens,
+        }
+        if payload is None:
+            kind, detail = refusal or (None, None)
+            record.update(
+                {
+                    "executed": False,
+                    "refused_by": kind,
+                    "refusal_detail": detail,
+                    "action_num": self.action_count,
+                    "level_after": None,
+                    "board_changed": None,
+                    "gameplay_changed": None,
+                    "no_op": None,
+                    "verdict": _BLOCKED_VERDICTS.get(kind or "", "BLOCKED (never executed)"),
+                    "level_completed": None,
+                    "game_over": None,
+                    "run_complete": None,
+                    "state": None,
+                    "score": None,
+                    "reward": None,
+                    "automatic": False,
+                    "run_elapsed_seconds": None,
+                }
+            )
+            return record
+        record.update(
